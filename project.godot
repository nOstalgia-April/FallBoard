; FallBoard — open this file with Godot 4.5.1.
config_version=5

[application]
config/name="FallBoard"
config/description="A small board. A decisive push. 九宫格推落战术原型。"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.07, 0.086, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
